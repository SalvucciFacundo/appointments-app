# Copiá este archivo a .env y ajustá los valores. En docker compose estos
# valores los inyecta el servicio `backend` de docker-compose.yml.
# PostgreSQL connection string en formato pgx.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appointments?sslmode=disable
# Puerto HTTP del API.
PORT=8080
# API key estática del dashboard (stub de auth). Vacía = rutas owner sin protección.
API_KEY=
# Owner fijo para el dashboard de un solo dueño (stub).
OWNER_ID=dashboard-owner
# Orígenes CORS permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# URL pública del frontend SPA.
APP_URL=http://localhost:5173

# --- Auth (user-auth change) ---
# TTL de la sesión (formato Go duration, ej: 24h). Las cookies session/csrf_token
# expiran con esta ventana.
SESSION_TTL=24h
# Cookies Secure en producción. En dev local sobre http://localhost hay que
# setear COOKIE_SECURE=false o el navegador rechaza las cookies.
COOKIE_SECURE=false
# Email del owner bootstrap: registrarse con este email crea rol OWNER.
OWNER_BOOTSTRAP_EMAIL=dashboard-owner@localhost
# Deshabilitar el fallback X-API-Key una vez migrada toda la UI a sesiones.
AUTH_DISABLE_API_KEY=false
# Parámetros Argon2id para hashear passwords (no cambiar sin motivo).
ARGON2_MEMORY=65536
ARGON2_TIME=1
