# Copiá este archivo a .env y ajustá los valores. En docker compose estos
# valores los inyecta el servicio `backend` de docker-compose.yml.
# PostgreSQL connection string en formato pgx.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/appointments?sslmode=disable
# Puerto HTTP del API.
PORT=8080
# API key estática del dashboard (stub de auth). Vacía = rutas owner sin protección.
API_KEY=
# Owner fijo para el dashboard de un solo dueño (stub).
OWNER_ID=dashboard-owner
# Orígenes CORS permitidos, separados por coma.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# URL pública del frontend SPA.
APP_URL=http://localhost:5173
